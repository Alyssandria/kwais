# Copy to backend/.env.production on the server and fill in. Never commit the real file.
# DATABASE_URL, PORT, NODE_ENV and TRUST_PROXY are set by docker-compose.ec2.yml.

CLIENT_URL=https://kwais.duckdns.org

# openssl rand -hex 48   (run twice, one value each)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30

# openssl rand -base64 32
# Back this up outside the server. Without it, stored lab values cannot be read, even from backups.
LAB_ENCRYPTION_KEY=
LAB_ENCRYPTION_KEY_VERSION=1

# mock until you have a key. Free-tier Gemini keys: fictional data only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=20000
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_QUEUE_WAIT_MS=15000

MAIL_TRANSPORT=smtp
MAIL_FROM="K-WAIS <your-verified-address@example.com>"
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

AUTH_ATTEMPTS_PER_15_MIN=10
API_REQUESTS_PER_15_MIN=600
SOFT_DELETE_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
