{
  "name": "kwais-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "K-WAIS web app: React + Vite + Tailwind",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
