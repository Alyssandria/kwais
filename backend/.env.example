# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_URL=http://localhost:5173

# PostgreSQL — matches docker-compose.yml at the repo root
DATABASE_URL=postgresql://kwais:kwais_dev_password@localhost:5432/kwais?schema=public

# Auth secrets (Section 3). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Lab result field encryption (Section 5). 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LAB_ENCRYPTION_KEY=
LAB_ENCRYPTION_KEY_VERSION=1

# AI (Section 7). Use "mock" for offline development.
# Free-tier Gemini keys: fictional data only.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=20000
