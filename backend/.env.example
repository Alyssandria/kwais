# Copy to .env and adjust. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_URL=http://localhost:5173

# PostgreSQL — matches docker-compose.yml at the repo root
DATABASE_URL=postgresql://kwais:kwais_dev_password@localhost:5432/kwais?schema=public

# Auth secrets: required, at least 32 characters each. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_MINUTES=30

# Lab result encryption: required. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key means stored lab values can no longer be read. Back it up securely.
LAB_ENCRYPTION_KEY=
LAB_ENCRYPTION_KEY_VERSION=1
# Only during a key rotation: the old key and its version, so existing rows still decrypt.
LAB_ENCRYPTION_KEY_PREVIOUS=
LAB_ENCRYPTION_KEY_PREVIOUS_VERSION=

# AI: gemini, or mock to work offline. Free-tier Gemini keys: fictional data only.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=20000
# Outbound pacing for Gemini. Free tier allows about 10 requests a minute; each analysed meal uses up to 2.
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_QUEUE_WAIT_MS=15000

# Email: console prints emails in this terminal; smtp sends them.
# Brevo (free, 300 emails a day): create an account, verify a sender address under Senders,
# then copy the SMTP login and an SMTP key from SMTP & API. MAIL_FROM must use the verified address.
MAIL_TRANSPORT=console
MAIL_FROM="K-WAIS <your-verified-address@example.com>"
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Number of reverse proxies in front of the API (0 when the API is reached directly)
TRUST_PROXY=0
# Sign-in, register, password and delete-account attempts per IP. Raise only locally for end-to-end runs
AUTH_ATTEMPTS_PER_15_MIN=10
# All API requests per IP. Each page makes several; a clinic network may share one IP
API_REQUESTS_PER_15_MIN=600
# Deleted meals are kept this many days, then purged
SOFT_DELETE_RETENTION_DAYS=30
# Audit log entries older than this are purged
AUDIT_RETENTION_DAYS=365
